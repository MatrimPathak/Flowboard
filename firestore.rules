rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    // Check if the requesting user has a member doc for this workspace.
    // The members collection is flat (root-level) with workspaceId + userId fields.
    // Because Firestore rules don't support queries, we check a known path pattern.
    // NOTE: This requires the members collection to be queryable in rules, which
    // it is since we're using exists() + get() on specific docs.
    // For a scalable approach, set Firebase Auth Custom Claims on workspace join.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + workspaceId))
        // Fallback: any authenticated user can read (for MVP).
        // Tighten this once Custom Claims are implemented.
        || isAuthenticated();
    }

    // ── Chronicle Docs ────────────────────────────────────────────────────────
    // Both the web client SDK (docs-firestore.ts) and the Flutter app write
    // directly to these subcollections.
    match /workspaces/{workspaceId}/docs/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /workspaces/{workspaceId}/projects/{projectId}/docs/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ── Members (root collection) ─────────────────────────────────────────────
    // Flutter app reads members to resolve assignees, list workspace members, etc.
    // Flutter app also writes members when creating workspaces or joining via
    // invite code. Web app continues to use Admin SDK (bypasses rules).
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // ── Legacy flat docs collection ───────────────────────────────────────────
    match /docs/{docId} {
      allow read, write: if false;
    }

    // ── Workspaces ────────────────────────────────────────────────────────────
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();

      // ── Projects ────────────────────────────────────────────────────────────
      match /projects/{projectId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();

        // Project members subcollection
        match /members/{memberId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated();
        }

        // ── Tasks and all task subcollections ────────────────────────────────
        match /tasks/{taskId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated();

          match /comments/{commentId} {
            allow read: if isAuthenticated();
            allow create: if isAuthenticated();
            allow update, delete: if isAuthenticated() &&
              resource.data.authorId == request.auth.uid;
          }

          match /worklogs/{worklogId} {
            allow read: if isAuthenticated();
            allow create, update, delete: if isAuthenticated();
          }

          match /attachments/{attachmentId} {
            allow read: if isAuthenticated();
            allow create, update, delete: if isAuthenticated();
          }

          match /links/{linkId} {
            allow read: if isAuthenticated();
            allow create, update, delete: if isAuthenticated();
          }

          match /activity/{activityId} {
            allow read: if isAuthenticated();
            allow create: if isAuthenticated();
            allow update, delete: if false; // Activity is immutable
          }
        }

        // ── Sprints ──────────────────────────────────────────────────────────
        match /sprints/{sprintId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated();
        }

        // ── Versions / Releases ──────────────────────────────────────────────
        match /versions/{versionId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated();
        }
      }
    }

    // ── Default: authenticated read, no write ─────────────────────────────────
    // Any collection not explicitly matched above.
    // The web app's Admin SDK still bypasses these rules for server-side writes.
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
